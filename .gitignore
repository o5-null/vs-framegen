# ── 统一工作区：子仓库仍在根下，构建产物与共享缓存收进 repos\ ──────────────
# 子仓库: mpv-playkit / k7sfunc / k7sfunc-wiki / mpv-src / ngxsdk / vsaji
# 缓存: repos/.cache/downloads；产物: repos/dist（含 0.6–1.7 GB 的档位包）
/repos/
/mpv-playkit/
/k7sfunc/
/k7sfunc-wiki/
/mpv-src/
/ngxsdk/
/vsaji/
# 文档静态页输出（不是仓库）：/k7sfunc-wiki-pages/、/vs-framegen-wiki-pages/
/k7sfunc-wiki-pages/
/vs-framegen-wiki-pages/

# ── 第三方 / 参考 / 大体积素材，不进仓库 ──────────────────────────────
# 参考插件: SmoothMyVideo 源码与便携版（6 GB，只读参考）
/参考插件/
# 测试环境: mpv-lazy 便携版 + vs-plugins（4.7 GB）
/测试环境/
# 测试数据: 源帧、各引擎生成帧、raw 序列（7.5 GB，报告快照在 bench\results）
/测试数据/
# 代理运行目录与中间产物（TRT engine 缓存、日志）
/work/
# 开发用播放器（根下一次性 mpv 副本，见 AGENT.md「开发用播放器」；只保留同步脚本）
/dev/*
!/dev/sync.cmd
# uv 虚拟环境（vapoursynth + numpy，见 AGENT.md；.venv 为主，.venv* 为实验环境）
/.venv/
/.venv*/
# mpv 源码与构建树（只读参考，体积大；放在根下 mpv-src\，已在上面的忽略列表里）
/mpv-winbuild/
# OSD 参数桥的上行报告（运行时生成）
*.k7f.json
# 从 SmoothMyVideo 提取/打包的引擎与解锁包（1 GB）
/dist/
# RIFE / ONNX 模型与 RTX runtime 实验目录
/rife/
/rife4k/
# vsrife 的 ONNX 模型（27 MB，按约定与上面的 rife\ 一致不进仓库）
/vsrife/models/
# VS Code 本地历史
/.history/
.history/
# 参考实现（第三方的 encore-mod 副本，含 222 MB 二进制代理）
/ref/encore-mod/

# ── 构建产物 ────────────────────────────────────────────────────────
*.obj
*.exe
*.dll
*.lib
*.exp
*.pdb
*.ilk
*.res
# vs-dlssg\bin: 构建出的四个 DLL + 四个第三方引擎包（dlss45/xessfg/vfg/fsr4），都不进仓库
/vs-dlssg/bin/
/vs-dlssg/obj/
/archive/**/*.obj
/archive/**/*.dll

# ── NVIDIA SDK（DLSS SDK 是一个独立 git clone；克隆到 ngxsdk\ 或设 NGX_SDK 覆盖）──
# 克隆位置是根下 ngxsdk\（已在上面的忽略列表里）

# ── 媒体素材 ────────────────────────────────────────────────────────
/media/frames/
/media/seq/
/media/review/
/media/*.mp4
/media/*.ffindex

# ── 跑测残留 ────────────────────────────────────────────────────────
*.log
*.out
*.err
*.ppm
*.raw
*.engine
*.cubin
__pycache__/
*.py[cod]
.pytest_cache/
.vscode/

# 测试套件产物（保留目录，忽略每次运行的结果）
/test/artifacts/
